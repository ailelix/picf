{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "picf",
	"compatibility_date": "2026-09-28",
	"compatibility_flags": [
		"nodejs_als"
	],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": true,
	"preview_urls": true,
	// R2 存储桶和 D1 数据库的名称可以修改（见 README「自定义 R2 和 D1 的名称」）：部署时已有同名资源
	// 就直接绑定，没有则自动创建。绑定以本文件为准，在控制台中修改绑定会在下次部署时被覆盖
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "picf-images"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "picf-db",
			// 不填 database_id：部署时 wrangler 会沿用已绑定的数据库，或按名称绑定已有的同名数据库，
			// 都没有则自动创建。填了 ID 时 wrangler 不会自动创建，ID 不存在就会部署失败
			"migrations_dir": "migrations"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	// 所有配置都是环境变量，在 Cloudflare 控制台设置，列表和说明见 README（本地开发写在 .env）。
	// 部署时保留控制台里的变量，不用本文件覆盖
	"keep_vars": true
}
