# 环境变量。线上在 Cloudflare 控制台设置；本地开发时复制为 .env 并填写。各项说明见 README。

# 管理员账号（必填）
ADMIN_USER=admin
ADMIN_PASSWORD=

# R2 公共访问地址（线上必填）。本地的 R2 是模拟的，没有公共域名，本地开发留空即可，
# 文件由仅在开发模式下可用的 /i/ 路由提供
# R2_PUBLIC_URL=

# 以下为选填项，未设置时使用注释中的默认值
# CF_IMAGE=true
# CONVERT_FORMATS=jpeg,png,bmp,tiff,heic
# CONVERT_TO=webp
# QUALITY=80
# ALLOW_ANONYMOUS=false
# ALLOW_VIDEO=true
# TIMEZONE=UTC
